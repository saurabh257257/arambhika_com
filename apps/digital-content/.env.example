# Required
ADMIN_PASSWORD=
PORT=4000

# Image generation (BytePlus ModelArk) and caption / post text (Claude)
BYTEPLUS_API_KEY=
ANTHROPIC_API_KEY=

# Where generated images are served from; leave empty to use the request's own address
PUBLIC_BASE_URL=


# Optional: keep login sessions across restarts (a random one is made at start otherwise)
SESSION_SECRET=

# Optional locations (the deploy script sets these outside the release folder)
DB_PATH=
UPLOADS_DIR=
