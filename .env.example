PORT=3000

# Zoho Commerce storefront (public API, no token needed)
# "in" or "com" - the Zoho data center your store is on
ZOHO_DC=in
# Published storefront domain of the Zoho store (Zoho Commerce > "View Store")
ZOHO_STOREFRONT_DOMAIN=armabhika.zohoecommerce.in

# Optional
# CATALOG_CACHE_SECONDS=30
# ZOHO_IMAGE_SIZE=1000x1000
