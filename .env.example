PORT=3000

# Zoho Commerce storefront (public API, no token needed)
# "in" or "com" - the Zoho data center your store is on
ZOHO_DC=in
# Published storefront domain of the Zoho store (Zoho Commerce > "View Store")
ZOHO_STOREFRONT_DOMAIN=armabhika.zohoecommerce.in

# Optional
# How often (seconds) the server refreshes the catalog from Zoho in the background. Visitors never wait for it.
# CATALOG_CACHE_SECONDS=30
# ZOHO_IMAGE_SIZE=1000x1000

# --- Zoho Admin connection (order status, invoices, e-way bills) ---
# From api-console.zoho.in > your "Server-based Application" client.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# A password of your choosing for the /admin/zoho-connect, /admin/zoho-status and
# /admin/zoho-orders pages.
# ADMIN_TOKEN=
# Needed to look up invoices (Zoho Books) and e-way bills (Zoho Inventory) for an order.
# Find these in each app's own Settings > Organization Profile in Zoho.
# ZOHO_BOOKS_ORG_ID=
# ZOHO_INVENTORY_ORG_ID=

# --- TEMPORARY test-mode login ---
# Login accepts only this one mobile number, with no real OTP, so the order+payment flow can
# be tested before MSG91's DLT registration is approved. Defaults to 8886772827 if unset.
# Replace with real MSG91 OTP login once DLT approval comes through, before any real
# customer uses this site.
# ALLOWED_TEST_MOBILE=8886772827
